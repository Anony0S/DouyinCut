{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workbench",
  "description": "工作台窗口权限：适用于开发主窗口和运行时窗口",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main", "workbench"],
  "permissions": [
    "allow-complete-exit",
    "allow-window-preferences",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://douyin.com/*" },
        { "url": "http://*.douyin.com/*" },
        { "url": "https://douyin.com/*" },
        { "url": "https://*.douyin.com/*" }
      ]
    },
    "core:default"
  ]
}
